model AiConversation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  roleContext String   @map("role_context") // client | coach
  startedAt   DateTime @default(now()) @map("started_at")

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // user | assistant | tool
  content        String
  toolCallsJson  Json?    @map("tool_calls_json")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// SYSTEM
// ---------------------------------------------------------------------------

// One row per browser that agreed to receive pushes — a client on a phone and
// a laptop is two rows, and both should ring.
//
// endpoint is unique because it IS the browser's identity to the push service.
// Re-subscribing on the same device returns the same endpoint, so upserting on
// it is what stops duplicates piling up every time the app is opened.
//
// Subscriptions expire on their own — the browser is reinstalled, permission
// is revoked, the push service retires it. The send path deletes any row the
// service reports as gone, so this table prunes itself rather than slowly
// filling with endpoints that can never be delivered to.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// A day of meals a coach has written for one client.
//
// This is the thing coaches do over text constantly — "go with the pollo
// asado", "chicken burrito bowl with double rice at lunch" — and the app had
// nowhere to put it. Without a plan the nutrition screen opens on a search
// box, which only helps somebody who already knows what they should be
// eating.
//
// One active plan per client at a time. A history of superseded plans is
// worth keeping (it shows what was asked of somebody in the weeks a change
// actually happened), so replacing a plan deactivates the old one instead of
// deleting it.
model MealPlan {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  coachId   String?  @map("coach_id")
  name      String
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  client Client         @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  coach  User?          @relation("MealPlanCoach", fields: [coachId], references: [id])
  items  MealPlanItem[]

  @@index([clientId, active])
  @@map("meal_plans")
}

// One line of a plan.
//
// The macros are copied onto the row rather than read through recipeId at
// display time. A recipe edited in November must not silently rewrite what a
// client was told to eat in September, and a plan line has to keep working
// when the recipe behind it is deleted.
model MealPlanItem {
  id       String  @id @default(uuid())
  planId   String  @map("plan_id")
  meal     String // breakfast | lunch | dinner | snack
  position Int     @default(0)

  // Set when the line came from the library, so the client can open the full
  // recipe. Null for a line the coach typed straight in.
  recipeId String? @map("recipe_id")
  foodId   String? @map("food_id")

  name     String
  quantity Decimal @default(1) @db.Decimal(6, 2)
  calories Int
  protein  Decimal @db.Decimal(6, 2)
  carbs    Decimal @db.Decimal(6, 2)
  fat      Decimal @db.Decimal(6, 2)
  note     String?

  plan   MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe Recipe?  @relation(fields: [recipeId], references: [id])
  food   Food?    @relation(fields: [foodId], references: [id])

  @@index([planId])
  @@map("meal_plan_items")
}

// When a coach is open for calls, one row per weekly window.
//
// Stored as minutes from midnight in the coach's own timezone rather than as
// absolute times, because "Tuesdays 9 to 5" is what a person actually means
// and it has to keep meaning that through a daylight saving change. Turning
// these into real instants is lib/schedule.ts's job, and it is the part of
// this feature most likely to be wrong, so it is the part with tests.
model CoachAvailability {
  id          String  @id @default(uuid())
  coachId     String  @map("coach_id")
  // 0 = Sunday through 6 = Saturday, matching Date.getUTCDay().
  weekday     Int
  startMinute Int     @map("start_minute")
  endMinute   Int     @map("end_minute")
  slotMinutes Int     @default(30) @map("slot_minutes")
  active      Boolean @default(true)

  coach User @relation("CoachAvailability", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, weekday])
  @@map("coach_availability")
}

// A booked call.
//
// The unique on (coachId, startsAt) is the only thing that actually prevents
// a double booking. Checking for a clash before inserting is a race — two
// clients tapping Book in the same second both read an empty slot — so the
// constraint is what makes it correct and the check is only there to produce
// a decent error message.
model Booking {
  id          String    @id @default(uuid())
  coachId     String    @map("coach_id")
  clientId    String    @map("client_id")
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  // booked | cancelled | completed
  status      String    @default("booked")
  note        String?
  // Whatever the coach wants people to join on — a Meet link, a phone number.
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")
  // "coach" or "client", so the other side can be told who dropped it.
  cancelledBy String?   @map("cancelled_by")

  coach  User @relation("BookingCoach", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)

  // No @@unique here even though the database has one. The constraint that
  // matters is PARTIAL — unique on (coach_id, starts_at) WHERE status =
  // 'booked' — because a plain unique would let a cancelled call block its own
  // slot forever and nobody could rebook it. Prisma cannot express a partial
  // unique index, so it lives in schedule-migration.sql and is deliberately
  // absent here rather than being declared wrong.
  @@index([clientId, startsAt])
  @@index([coachId, startsAt])
  @@map("bookings")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@map("audit_logs")
}
