// ARISE — main database schema
// This mirrors the schema approved in coaching-platform-architecture.md.
// Run `npm run db:migrate` once DATABASE_URL is set to turn this into real tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum Role {
  client
  coach
  admin
}

// Mirrors the Supabase Auth user by id. Supabase owns the password/session;
// this table is what the rest of ARISE joins against.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(client)
  createdAt DateTime @default(now()) @map("created_at")

  profile               Profile?
  clientRecord          Client?                    @relation("ClientUser")
  coachRelationships     CoachClientRelationship[] @relation("CoachSide")
  clientRelationships    CoachClientRelationship[] @relation("ClientSide")
  coachNotesAuthored     CoachNote[]                @relation("NoteAuthor")
  messagesSent           Message[]                  @relation("MessageSender")
  messagesReceived       Message[]                  @relation("MessageRecipient")
  notifications          Notification[]
  aiConversations        AiConversation[]
  auditLogEntries        AuditLog[]                 @relation("AuditActor")
  pushSubscriptions      PushSubscription[]
  mealLogsReviewed       NutritionLog[]             @relation("MealReviewer")
  mealPlansWritten       MealPlan[]                 @relation("MealPlanCoach")
  availability           CoachAvailability[]        @relation("CoachAvailability")
  bookingsAsCoach        Booking[]                  @relation("BookingCoach")
  bookingsAsClient       Booking[]                  @relation("BookingClient")
  healthToken            HealthToken?               @relation("HealthTokenClient")
  workoutTemplatesOwned  WorkoutTemplate[]           @relation("TemplateCoach")
  recipesCreated         Recipe[]                    @relation("RecipeCoach")
  cardioTypes            CardioType[]                @relation("CardioCoach")
  autoMessages           AutoMessage[]               @relation("AutoMessageCoach")

  @@map("users")
}

// A token a client's phone uses to post their own health data.
//
// Not a login. It authenticates one narrow write — steps and bodyweight for
// one client — so it can live in an iOS Shortcut or Health Auto Export
// without being worth stealing. Hashed at rest for the same reason a password
// would be: the plaintext is shown once, at creation, and never again.
model HealthToken {
  id         String    @id @default(uuid())
  clientId   String    @unique @map("client_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  client User @relation("HealthTokenClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@map("health_tokens")
}

model Profile {
  userId    String   @id @map("user_id")
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  phone     String?
  timezone  String?  @default("America/New_York")
  // Where a booked call happens — a standing Meet link, a phone number,
  // whatever the coach wants people to join on. Copied onto each booking so
  // changing it later cannot rewrite where a past call was held.
  bookingLocation String? @map("booking_location")
  /*
    Which background the client picked. Null means the default.

    A plain string rather than an enum: the set of themes is a CSS concern
    that will change more often than the database should, and an unknown
    value falls back to the default rather than failing to render.
  */
  background String? @map("background")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// Lets ARISE support more than one coach later without restructuring anything.
model CoachClientRelationship {
  id         String   @id @default(uuid())
  coachId    String   @map("coach_id")
  clientId   String   @map("client_id")
  status     String   @default("active") // active | inactive
  assignedAt DateTime @default(now()) @map("assigned_at")

  coach  User @relation("CoachSide", fields: [coachId], references: [id])
  client User @relation("ClientSide", fields: [clientId], references: [id])

  @@unique([coachId, clientId])
  @@index([clientId])
  @@map("coach_client_relationships")
}

// ---------------------------------------------------------------------------
// COACHING RELATIONSHIP / CRM
// ---------------------------------------------------------------------------

enum ClientStatus {
  lead
  payment_pending
  paid
  agreement_pending
  onboarding
  active
  paused
  ending_soon
  completed
  cancelled
}

model Client {
  userId      String       @id @map("user_id")
  coachId     String?      @map("coach_id")
  status      ClientStatus @default(lead)
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  currentWeek Int?         @map("current_week")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)

  coachNotes        CoachNote[]
  subscriptions      Subscription[]
  payments           Payment[]
  paymentLinks       PaymentLink[]
  agreements         Agreement[]
  onboardingResponses OnboardingResponse[]
  clientPrograms      ClientProgram[]
  workoutLogs         WorkoutLog[]
  nutritionLogs       NutritionLog[]
  nutritionTargets    NutritionTarget[]
  dailyGoals          DailyGoal[]
  dailyGoalLogs       DailyGoalLog[]
  stepLogs            StepLog[]
  weightLogs          WeightLog[]
  measurements        Measurement[]
  progressPhotos      ProgressPhoto[]
  checkIns            CheckIn[]
  mealPlans           MealPlan[]
  scheduledItems      ScheduledItem[]
  cardioLogs          CardioLog[]

  @@index([coachId])
  @@index([status])
  @@map("clients")
}

model CoachNote {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  coachId   String   @map("coach_id")
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  coach  User   @relation("NoteAuthor", fields: [coachId], references: [id])

  @@index([clientId])
  @@map("coach_notes")
}

// ---------------------------------------------------------------------------
// PAYMENTS & AGREEMENTS
//
// Payment, signature, and account activation are meant to feel like one
// continuous step for the client, but under the hood they're three
// deliberately separate records: PaymentLink (what the coach generated and
// sent), Payment (what actually happened with money), and Agreement (the
// legal document + signature). Keeping them separate means a payment is
// never quietly lost if signing fails, and a signed agreement always has a
// frozen, re-renderable-never-again snapshot of exactly what was agreed to.
// ---------------------------------------------------------------------------

enum BillingType {
  one_time
  subscription
  payment_plan
}

enum PaymentProviderType {
  stripe
  fanbasis
}

enum PaymentFrequency {
  one_time
  weekly
  biweekly
  monthly
}

enum PaymentStatus {
  succeeded
  failed
  refunded
  pending
}

enum PaymentLinkStatus {
  pending
  paid
  expired
  cancelled
}

// A reusable coaching offer — "6-Month Transformation," "12-Month Elite,"
// etc. Selecting one when generating a payment link pre-fills everything
// below, but every field can be overridden per client on PaymentLink so
// ARISE never assumes two clients on the same plan committed to identical
// terms.
model Plan {
  id               String              @id @default(uuid())
  name             String
  price            Decimal             @db.Decimal(10, 2)
  billingType      BillingType         @map("billing_type")
  paymentFrequency PaymentFrequency?   @map("payment_frequency") // null when billingType = one_time
  numberOfPayments Int?                @map("number_of_payments") // null = ongoing subscription with no fixed count
  termMonths       Int                 @map("term_months") // agreement duration: 3, 4, 6, 12...
  defaultProvider  PaymentProviderType @map("default_provider")
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")

  subscriptions Subscription[]
  agreements    Agreement[]
  paymentLinks  PaymentLink[]

  @@map("plans")
}

model Subscription {
  id                    String              @id @default(uuid())
  clientId              String              @map("client_id")
  planId                String              @map("plan_id")
  // The link that created this subscription, and therefore the agreed terms:
  // price, frequency, and how many payments were sold. Without this there is
  // no reliable way to know when a fixed plan has been paid off, which is how
  // it came to bill forever.
  paymentLinkId         String?             @map("payment_link_id")
  provider              PaymentProviderType
  providerSubscriptionId String?            @map("provider_subscription_id")
  // active | past_due | canceled | completed. `completed` means the agreed
  // number of payments was reached and the subscription was cancelled at the
  // provider on purpose — see lib/billing.ts mergeStatus.
  status                String              @default("active")
  currentPeriodEnd      DateTime?           @map("current_period_end")
  createdAt             DateTime            @default(now()) @map("created_at")
  deletedAt             DateTime?           @map("deleted_at") // soft delete only — never hard-delete billing records

  client      Client       @relation(fields: [clientId], references: [userId])
  plan        Plan         @relation(fields: [planId], references: [id])
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id])
  payments    Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([clientId])
  @@index([paymentLinkId])
  @@map("subscriptions")
}

// One row per payment link a coach generates and sends — this is what makes
// "did they pay yet" answerable before any money has actually moved, and is
// what the Stripe/FanBasis webhook looks up by providerRef to know which
// client + plan + agreement template a completed checkout belongs to.
model PaymentLink {
  id                       String              @id @default(uuid())
  clientId                 String              @map("client_id")
  planId                   String              @map("plan_id")
  agreementTemplateId      String              @map("agreement_template_id")
  provider                 PaymentProviderType
  priceOverride            Decimal?            @map("price_override") @db.Decimal(10, 2)
  paymentFrequencyOverride PaymentFrequency?   @map("payment_frequency_override")
  numberOfPaymentsOverride Int?                @map("number_of_payments_override")
  termMonthsOverride       Int?                @map("term_months_override")
  startDate                DateTime            @map("start_date") @db.Date
  checkoutUrl              String              @map("checkout_url")
  providerRef              String              @map("provider_ref") // Stripe Checkout Session id, or manual FanBasis reference
  status                   PaymentLinkStatus   @default(pending)
  createdAt                DateTime            @default(now()) @map("created_at")
  expiresAt                DateTime?           @map("expires_at")

  client   Client            @relation(fields: [clientId], references: [userId])
  plan     Plan              @relation(fields: [planId], references: [id])
  template AgreementTemplate @relation(fields: [agreementTemplateId], references: [id])
  payment  Payment?
  agreement Agreement?
  subscriptions Subscription[]

  @@index([clientId])
  @@index([providerRef])
  @@map("payment_links")
}

model Payment {
  id                String              @id @default(uuid())
  clientId          String              @map("client_id")
  subscriptionId    String?             @map("subscription_id")
  paymentLinkId     String?             @unique @map("payment_link_id")
  provider          PaymentProviderType
  providerPaymentId String?             @map("provider_payment_id")
  amount            Decimal             @db.Decimal(10, 2)
  status            PaymentStatus
  paidAt            DateTime?           @map("paid_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  deletedAt         DateTime?           @map("deleted_at") // soft delete only

  client       Client        @relation(fields: [clientId], references: [userId])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  paymentLink  PaymentLink?  @relation(fields: [paymentLinkId], references: [id])

  // Idempotency for provider webhooks: Stripe retries a delivery it did not
  // get a 2xx for, and reuses an invoice id across payment retries. Declared
  // here as well as in the migration so a later `prisma migrate` sees it as
  // intended rather than as drift to be dropped.
  @@unique([provider, providerPaymentId])
  @@index([clientId])
  @@map("payments")
}

model AgreementTemplate {
  id        String   @id @default(uuid())
  name      String
  body      String   // stores the {{variable}} template text
  version   Int      @default(1)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  agreements   Agreement[]
  paymentLinks PaymentLink[]

  @@map("agreement_templates")
}

model Agreement {
  id               String            @id @default(uuid())
  clientId         String            @map("client_id")
  paymentLinkId    String?           @unique @map("payment_link_id")
  templateId       String            @map("template_id")
  templateVersion  Int               @map("template_version")
  renderedText     String            @map("rendered_text") // frozen snapshot at signing time — never re-rendered later
  planId           String            @map("plan_id")
  price            Decimal           @db.Decimal(10, 2)
  paymentFrequency PaymentFrequency? @map("payment_frequency")
  numberOfPayments Int?              @map("number_of_payments")
  startDate        DateTime          @map("start_date") @db.Date
  termMonths       Int               @map("term_months")
  status           String            @default("pending_signature") // pending_signature | signed
  createdAt        DateTime          @default(now()) @map("created_at")
  deletedAt        DateTime?         @map("deleted_at") // soft delete only

  client      Client             @relation(fields: [clientId], references: [userId])
  paymentLink PaymentLink?       @relation(fields: [paymentLinkId], references: [id])
  template    AgreementTemplate  @relation(fields: [templateId], references: [id])
  plan        Plan               @relation(fields: [planId], references: [id])
  signature   AgreementSignature?

  @@index([clientId])
  @@map("agreements")
}

model AgreementSignature {
  id          String   @id @default(uuid())
  agreementId String   @unique @map("agreement_id")
  signedName  String   @map("signed_name")
  signedAt    DateTime @default(now()) @map("signed_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("signed")

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@map("agreement_signatures")
}

// ---------------------------------------------------------------------------
// ONBOARDING
// ---------------------------------------------------------------------------

model OnboardingResponse {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  stepKey     String    @map("step_key") // e.g. "goals", "injuries", "equipment"
  answerJson  Json      @map("answer_json")
  completedAt DateTime? @map("completed_at")

  client Client @relation(fields: [clientId], references: [userId])

  @@unique([clientId, stepKey])
  @@map("onboarding_responses")
}

// ---------------------------------------------------------------------------
// TRAINING
// ---------------------------------------------------------------------------

model ExerciseVideo {
  id              String  @id @default(uuid())
  storageProvider String  @map("storage_provider") // "supabase" | "mux"
  externalId      String  @map("external_id") // storage path or Mux asset id
  thumbnailUrl    String? @map("thumbnail_url")
  duration        Int?    // seconds

  exercises Exercise[]

  @@map("exercise_videos")
}

model Exercise {
  id               String   @id @default(uuid())
  name             String
  videoId          String?  @map("video_id")
  // A link the coach pastes — YouTube, Vimeo, a Supabase object, anything.
  // ExerciseVideo above is the uploaded-and-transcoded path; this is the one
  // that gets a library of 60 movements demonstrated in an afternoon.
  videoUrl         String?  @map("video_url")
  musclePrimary    String   @map("muscle_primary")
  muscleSecondary  String[] @map("muscle_secondary")
  equipment        String
  difficulty       String
  movementPattern  String?  @map("movement_pattern")
  instructions     String?
  cues             String?
  commonMistakes   String?  @map("common_mistakes")
  substitutions    String[]
  tags             String[]
  createdAt        DateTime @default(now()) @map("created_at")

  video           ExerciseVideo?    @relation(fields: [videoId], references: [id])
  workoutExercises WorkoutExercise[]

  @@index([musclePrimary])
  @@index([equipment])
  @@map("exercises")
}

model WorkoutTemplate {
  id          String   @id @default(uuid())
  coachId     String   @map("coach_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  coach          User            @relation("TemplateCoach", fields: [coachId], references: [id])
  workouts       Workout[]
  clientPrograms ClientProgram[]
  programDays    ProgramDay[]
  scheduledItems ScheduledItem[]

  @@map("workout_templates")
}

model Workout {
  id         String   @id @default(uuid())
  templateId String?  @map("template_id") // null = client-specific, customized copy
  name       String
  dayOrder   Int      @map("day_order")

  // The header of a workout as a client actually reads it: how long to set
  // aside, what they need around them, and what the coach wants out of the
  // session. Without these the screen is a bare list of movements.
  estMinutes   Int?     @map("est_minutes")
  equipment    String[]
  instructions String?

  template         WorkoutTemplate?  @relation(fields: [templateId], references: [id])
  workoutExercises WorkoutExercise[]
  workoutLogs      WorkoutLog[]
  programDays      ProgramDay[]
  scheduledItems   ScheduledItem[]

  @@map("workouts")
}

// ---------------------------------------------------------------------------
// PROGRAMMING — a week described once, then stamped across months
// ---------------------------------------------------------------------------

// One weekday of a template's repeating week.
//
// This is the piece that turns a handful of workouts into a program. A coach
// lays out Monday through Sunday one time — this workout here, cardio there,
// rest on Thursday and Sunday — and every week of the assignment is a copy of
// it. Six months stops being 180 decisions and becomes seven.
model ProgramDay {
  id         String  @id @default(uuid())
  templateId String  @map("template_id")
  // 1 = Monday .. 7 = Sunday. ISO numbering, so it lines up with date-fns and
  // with how a person reads a calendar, rather than JS's Sunday-first.
  weekday    Int
  kind       String  // workout | cardio | rest
  workoutId  String? @map("workout_id")
  // Shown instead of a workout name — "REST DAY", "Active recovery".
  label      String?
  // Cardio on top of whatever else the day holds. Steps are the default and
  // nearly always the real target, so they live on every day, not just cardio.
  cardioTypeId String? @map("cardio_type_id")
  cardioMinutes Int?   @map("cardio_minutes")
  stepTarget   Int?    @map("step_target")

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workout  Workout?        @relation(fields: [workoutId], references: [id])
  cardioType CardioType?   @relation(fields: [cardioTypeId], references: [id])

  @@unique([templateId, weekday])
  @@map("program_days")
}

// A dated row on one client's calendar.
//
// Written by the deploy, not read live off the template — so editing next
// month's plan can never rewrite what someone was asked to do last week, and
// a single client's Tuesday can be changed without touching anyone else.
model ScheduledItem {
  id       String   @id @default(uuid())
  clientId String   @map("client_id")
  date     DateTime @db.Date
  kind     String // workout | cardio | rest
  label    String

  workoutId    String? @map("workout_id")
  cardioTypeId String? @map("cardio_type_id")
  cardioMinutes Int?   @map("cardio_minutes")
  stepTarget   Int?    @map("step_target")

  // Which deploy put it here, so a re-deploy can clear its own rows and leave
  // anything the coach hand-placed alone.
  batchId    String?   @map("batch_id")
  templateId String?   @map("template_id")

  completedAt DateTime? @map("completed_at")

  client     Client           @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  workout    Workout?         @relation(fields: [workoutId], references: [id])
  cardioType CardioType?      @relation(fields: [cardioTypeId], references: [id])
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id])

  @@index([clientId, date])
  @@index([batchId])
  @@map("scheduled_items")
}

// ---------------------------------------------------------------------------
// CARDIO
// ---------------------------------------------------------------------------

// Walking, incline treadmill, stairmaster, bike, rower.
//
// A type carries its own unit because they aren't measured the same way:
// walking is a step count, a stairmaster is minutes. Storing "cardio: 40" with
// no unit is how a coach ends up guessing what a client meant.
model CardioType {
  id       String  @id @default(uuid())
  coachId  String  @map("coach_id")
  name     String
  unit     String  @default("steps") // steps | minutes | distance
  // What to ask for when this type is put on a day and no number is given.
  defaultTarget Int? @map("default_target")
  active   Boolean @default(true)
  position Int     @default(0)

  coach          User            @relation("CardioCoach", fields: [coachId], references: [id])
  programDays    ProgramDay[]
  scheduledItems ScheduledItem[]
  logs           CardioLog[]

  @@unique([coachId, name])
  @@map("cardio_types")
}

model CardioLog {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  cardioTypeId String   @map("cardio_type_id")
  date         DateTime @db.Date
  minutes      Int?
  steps        Int?
  distance     Decimal? @db.Decimal(6, 2)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  client     Client     @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  cardioType CardioType @relation(fields: [cardioTypeId], references: [id])

  // One log per type per day. The client's screen upserts against this, and
  // without it two quick submits both insert and the duplicate is invisible.
  @@unique([clientId, cardioTypeId, date])
  @@index([clientId, date])
  @@map("cardio_logs")
}

// ---------------------------------------------------------------------------
// AUTOMATIC MESSAGES
// ---------------------------------------------------------------------------

// Coach-written lines that go out on their own.
//
// Several per trigger on purpose: one rest-day message sent every Thursday for
// six months stops reading as a coach and starts reading as a cron job. The
// sender rotates, and never sends twice in one day to one client.
model AutoMessage {
  id      String  @id @default(uuid())
  coachId String  @map("coach_id")
  trigger String // rest_day
  body    String
  active  Boolean @default(true)
  position Int    @default(0)

  coach User @relation("AutoMessageCoach", fields: [coachId], references: [id])

  @@index([coachId, trigger])
  @@map("auto_messages")
}

// One row per client per day an automatic message actually went out. This is
// the thing that makes the sender safe to call as often as you like.
model AutoMessageSend {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  trigger   String
  date      DateTime @db.Date
  messageId String?  @map("message_id")

  @@unique([clientId, trigger, date])
  @@map("auto_message_sends")
}

model WorkoutExercise {
  id             String  @id @default(uuid())
  workoutId      String  @map("workout_id")
  exerciseId     String  @map("exercise_id")
  order          Int
  supersetGroup  String? @map("superset_group")
  notes          String?

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  sets    WorkoutSet[]

  @@index([workoutId])
  @@map("workout_exercises")
}

enum SetType {
  warmup
  working
  drop
}

model WorkoutSet {
  id                String  @id @default(uuid())
  workoutExerciseId String  @map("workout_exercise_id")
  setNumber         Int     @map("set_number")
  type              SetType @default(working)
  targetReps        String? @map("target_reps") // stored as text to support ranges like "8-10" or "to failure"
  targetWeight       Decimal? @map("target_weight") @db.Decimal(6, 2)
  targetRir          Int?     @map("target_rir")
  tempo              String?
  restSeconds        Int?     @map("rest_seconds")

  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  logs            WorkoutLogSet[]

  @@map("workout_sets")
}

// Lets one client have a customized copy of a shared template without
// touching anyone else's program.
model ClientProgram {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  templateId  String   @map("workout_template_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  active      Boolean  @default(true)

  client   Client          @relation(fields: [clientId], references: [userId])
  template WorkoutTemplate @relation(fields: [templateId], references: [id])

  @@index([clientId])
  @@map("client_programs")
}

model WorkoutLog {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  workoutId   String    @map("workout_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  duration    Int?      // seconds
  totalVolume Decimal?  @map("total_volume") @db.Decimal(10, 2)

  client  Client          @relation(fields: [clientId], references: [userId])
  workout Workout         @relation(fields: [workoutId], references: [id])
  sets    WorkoutLogSet[]

  @@index([clientId, startedAt])
  @@map("workout_logs")
}

model WorkoutLogSet {
  id             String   @id @default(uuid())
  workoutLogId   String   @map("workout_log_id")
  workoutSetId   String   @map("workout_set_id")
  actualWeight   Decimal? @map("actual_weight") @db.Decimal(6, 2)
  actualReps     Int?     @map("actual_reps")
  isPr           Boolean  @default(false) @map("is_pr")
  notes          String?

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  workoutSet WorkoutSet @relation(fields: [workoutSetId], references: [id])

  @@map("workout_log_sets")
}

// ---------------------------------------------------------------------------
// NUTRITION
// ---------------------------------------------------------------------------

model Food {
  id          String   @id @default(uuid())
  name        String
  source      String   @default("custom") // library | custom | recipe
  // Null for the shared library, set for a food one client saved.
  //
  // Without this, "Save for next time" wrote into a single global table and
  // the nutrition search read it unscoped — so one client's "Mom's lasagna"
  // appeared in every other client's results. Library rows stay null and stay
  // shared, which is the whole point of them.
  ownerId     String?  @map("owner_id")
  calories    Int
  protein     Decimal  @db.Decimal(6, 2)
  carbs       Decimal  @db.Decimal(6, 2)
  fat         Decimal  @db.Decimal(6, 2)
  servingSize String?  @map("serving_size")
  // Protein | Carbs | Fats | Veg | Fruit | Dairy | Meals | Snacks | Drinks |
  // Alcohol | Condiments. Only used for browsing when there's no search term —
  // a client who doesn't know what to type still needs a way in.
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  nutritionLogs NutritionLog[]
  mealPlanItems MealPlanItem[]

  @@index([ownerId])
  @@map("foods")
}

model Recipe {
  id              String   @id @default(uuid())
  coachId         String?  @map("coach_id")
  title           String
  imageUrl        String?  @map("image_url")
  calories        Int
  protein         Decimal  @db.Decimal(6, 2)
  carbs           Decimal  @db.Decimal(6, 2)
  fat             Decimal  @db.Decimal(6, 2)
  servingSize     String?  @map("serving_size")
  ingredientsJson Json     @map("ingredients_json")
  instructions    String
  prepTime        Int?     @map("prep_time")
  cookTime        Int?     @map("cook_time")
  tags            String[]
  createdAt       DateTime @default(now()) @map("created_at")

  coach         User?          @relation("RecipeCoach", fields: [coachId], references: [id])
  nutritionLogs NutritionLog[]
  mealPlanItems MealPlanItem[]

  @@index([calories])
  @@map("recipes")
}

model NutritionLog {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  date      DateTime @db.Date
  meal      String?  // breakfast | lunch | dinner | snack | null
  foodId    String?  @map("food_id")
  recipeId  String?  @map("recipe_id")
  quantity  Decimal  @default(1) @db.Decimal(6, 2)
  // Set only for quick-added entries the client chose not to save as a food.
  // Without it a one-off restaurant meal logs as an anonymous row.
  name      String?
  // Private bucket path, never a public URL — see lib/meal-photos.ts.
  photoPath String?  @map("photo_path")
  calories  Int
  protein   Decimal  @db.Decimal(6, 2)
  carbs     Decimal  @db.Decimal(6, 2)
  fat       Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at")

  // Where the numbers on this row came from:
  //   manual  — the client typed them in
  //   library — copied from a Food row
  //   recipe  — copied from a Recipe row
  //   photo   — read off a photograph
  source String @default("manual")

  // Set only when source is photo.
  //   estimated — nobody has looked at it yet
  //   confirmed — the coach agreed with the numbers
  //   corrected — the coach changed them
  //   failed    — the read didn't come back, so the row holds zeros and the
  //               client still needs to enter numbers
  // Null on every other source, which is what keeps the review queue from
  // filling up with rows nobody ever needs to look at.
  reviewState String? @map("review_state")

  // What was actually read off the photo: the items, the portion assumed for
  // each, and the model's own numbers. Kept separately from the columns above
  // so that a coach's correction can be compared against the original guess
  // rather than erasing it — the gap between the two is the only way to find
  // out whether the reads run consistently high or low.
  estimate Json?

  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")

  client     Client  @relation(fields: [clientId], references: [userId])
  food       Food?   @relation(fields: [foodId], references: [id])
  recipe     Recipe? @relation(fields: [recipeId], references: [id])
  reviewedBy User?   @relation("MealReviewer", fields: [reviewedById], references: [id])

  @@index([clientId, date])
  // Drives the coach's review queue, which reads oldest-unreviewed-first.
  @@index([reviewState, createdAt])
  @@map("nutrition_logs")
}

model NutritionTarget {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  calories      Int
  protein       Decimal  @db.Decimal(6, 2)
  carbs         Decimal  @db.Decimal(6, 2)
  fat           Decimal  @db.Decimal(6, 2)
  effectiveDate DateTime @map("effective_date") @db.Date

  client Client @relation(fields: [clientId], references: [userId])

  @@index([clientId, effectiveDate])
  @@map("nutrition_targets")
}

