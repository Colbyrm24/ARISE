// ARISE — main database schema
// This mirrors the schema approved in coaching-platform-architecture.md.
// Run `npm run db:migrate` once DATABASE_URL is set to turn this into real tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum Role {
  client
  coach
  admin
}

// Mirrors the Supabase Auth user by id. Supabase owns the password/session;
// this table is what the rest of ARISE joins against.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(client)
  createdAt DateTime @default(now()) @map("created_at")

  profile               Profile?
  clientRecord          Client?                    @relation("ClientUser")
  coachRelationships     CoachClientRelationship[] @relation("CoachSide")
  clientRelationships    CoachClientRelationship[] @relation("ClientSide")
  coachNotesAuthored     CoachNote[]                @relation("NoteAuthor")
  messagesSent           Message[]                  @relation("MessageSender")
  messagesReceived       Message[]                  @relation("MessageRecipient")
  notifications          Notification[]
  aiConversations        AiConversation[]
  auditLogEntries        AuditLog[]                 @relation("AuditActor")
  pushSubscriptions      PushSubscription[]
  mealLogsReviewed       NutritionLog[]             @relation("MealReviewer")
  mealPlansWritten       MealPlan[]                 @relation("MealPlanCoach")
  workoutTemplatesOwned  WorkoutTemplate[]           @relation("TemplateCoach")
  recipesCreated         Recipe[]                    @relation("RecipeCoach")

  @@map("users")
}

model Profile {
  userId    String   @id @map("user_id")
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  phone     String?
  timezone  String?  @default("America/New_York")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// Lets ARISE support more than one coach later without restructuring anything.
model CoachClientRelationship {
  id         String   @id @default(uuid())
  coachId    String   @map("coach_id")
  clientId   String   @map("client_id")
  status     String   @default("active") // active | inactive
  assignedAt DateTime @default(now()) @map("assigned_at")

  coach  User @relation("CoachSide", fields: [coachId], references: [id])
  client User @relation("ClientSide", fields: [clientId], references: [id])

  @@unique([coachId, clientId])
  @@index([clientId])
  @@map("coach_client_relationships")
}

// ---------------------------------------------------------------------------
// COACHING RELATIONSHIP / CRM
// ---------------------------------------------------------------------------

enum ClientStatus {
  lead
  payment_pending
  paid
  agreement_pending
  onboarding
  active
  paused
  ending_soon
  completed
  cancelled
}

model Client {
  userId      String       @id @map("user_id")
  coachId     String?      @map("coach_id")
  status      ClientStatus @default(lead)
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  currentWeek Int?         @map("current_week")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)

  coachNotes        CoachNote[]
  subscriptions      Subscription[]
  payments           Payment[]
  paymentLinks       PaymentLink[]
  agreements         Agreement[]
  onboardingResponses OnboardingResponse[]
  clientPrograms      ClientProgram[]
  workoutLogs         WorkoutLog[]
  nutritionLogs       NutritionLog[]
  nutritionTargets    NutritionTarget[]
  dailyGoals          DailyGoal[]
  dailyGoalLogs       DailyGoalLog[]
  stepLogs            StepLog[]
  weightLogs          WeightLog[]
  measurements        Measurement[]
  progressPhotos      ProgressPhoto[]
  checkIns            CheckIn[]
  mealPlans           MealPlan[]

  @@index([coachId])
  @@index([status])
  @@map("clients")
}

model CoachNote {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  coachId   String   @map("coach_id")
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  coach  User   @relation("NoteAuthor", fields: [coachId], references: [id])

  @@index([clientId])
  @@map("coach_notes")
}

// ---------------------------------------------------------------------------
// PAYMENTS & AGREEMENTS
//
// Payment, signature, and account activation are meant to feel like one
// continuous step for the client, but under the hood they're three
// deliberately separate records: PaymentLink (what the coach generated and
// sent), Payment (what actually happened with money), and Agreement (the
// legal document + signature). Keeping them separate means a payment is
// never quietly lost if signing fails, and a signed agreement always has a
// frozen, re-renderable-never-again snapshot of exactly what was agreed to.
// ---------------------------------------------------------------------------

enum BillingType {
  one_time
  subscription
  payment_plan
}

enum PaymentProviderType {
  stripe
  fanbasis
}

enum PaymentFrequency {
  one_time
  weekly
  biweekly
  monthly
}

enum PaymentStatus {
  succeeded
  failed
  refunded
  pending
}

enum PaymentLinkStatus {
  pending
  paid
  expired
  cancelled
}

// A reusable coaching offer — "6-Month Transformation," "12-Month Elite,"
// etc. Selecting one when generating a payment link pre-fills everything
// below, but every field can be overridden per client on PaymentLink so
// ARISE never assumes two clients on the same plan committed to identical
// terms.
model Plan {
  id               String              @id @default(uuid())
  name             String
  price            Decimal             @db.Decimal(10, 2)
  billingType      BillingType         @map("billing_type")
  paymentFrequency PaymentFrequency?   @map("payment_frequency") // null when billingType = one_time
  numberOfPayments Int?                @map("number_of_payments") // null = ongoing subscription with no fixed count
  termMonths       Int                 @map("term_months") // agreement duration: 3, 4, 6, 12...
  defaultProvider  PaymentProviderType @map("default_provider")
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")

  subscriptions Subscription[]
  agreements    Agreement[]
  paymentLinks  PaymentLink[]

  @@map("plans")
}

model Subscription {
  id                    String              @id @default(uuid())
  clientId              String              @map("client_id")
  planId                String              @map("plan_id")
  provider              PaymentProviderType
  providerSubscriptionId String?            @map("provider_subscription_id")
  status                String              @default("active")
  currentPeriodEnd      DateTime?           @map("current_period_end")
  createdAt             DateTime            @default(now()) @map("created_at")
  deletedAt             DateTime?           @map("deleted_at") // soft delete only — never hard-delete billing records

  client   Client    @relation(fields: [clientId], references: [userId])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([clientId])
  @@map("subscriptions")
}

// One row per payment link a coach generates and sends — this is what makes
// "did they pay yet" answerable before any money has actually moved, and is
// what the Stripe/FanBasis webhook looks up by providerRef to know which
// client + plan + agreement template a completed checkout belongs to.
model PaymentLink {
  id                       String              @id @default(uuid())
  clientId                 String              @map("client_id")
  planId                   String              @map("plan_id")
  agreementTemplateId      String              @map("agreement_template_id")
  provider                 PaymentProviderType
  priceOverride            Decimal?            @map("price_override") @db.Decimal(10, 2)
  paymentFrequencyOverride PaymentFrequency?   @map("payment_frequency_override")
  numberOfPaymentsOverride Int?                @map("number_of_payments_override")
  termMonthsOverride       Int?                @map("term_months_override")
  startDate                DateTime            @map("start_date") @db.Date
  checkoutUrl              String              @map("checkout_url")
  providerRef              String              @map("provider_ref") // Stripe Checkout Session id, or manual FanBasis reference
  status                   PaymentLinkStatus   @default(pending)
  createdAt                DateTime            @default(now()) @map("created_at")
  expiresAt                DateTime?           @map("expires_at")

  client   Client            @relation(fields: [clientId], references: [userId])
  plan     Plan              @relation(fields: [planId], references: [id])
  template AgreementTemplate @relation(fields: [agreementTemplateId], references: [id])
  payment  Payment?
  agreement Agreement?

  @@index([clientId])
  @@index([providerRef])
  @@map("payment_links")
}

model Payment {
  id                String              @id @default(uuid())
  clientId          String              @map("client_id")
  subscriptionId    String?             @map("subscription_id")
  paymentLinkId     String?             @unique @map("payment_link_id")
  provider          PaymentProviderType
  providerPaymentId String?             @map("provider_payment_id")
  amount            Decimal             @db.Decimal(10, 2)
  status            PaymentStatus
  paidAt            DateTime?           @map("paid_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  deletedAt         DateTime?           @map("deleted_at") // soft delete only

  client       Client        @relation(fields: [clientId], references: [userId])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  paymentLink  PaymentLink?  @relation(fields: [paymentLinkId], references: [id])

  @@index([clientId])
  @@map("payments")
}

model AgreementTemplate {
  id        String   @id @default(uuid())
  name      String
  body      String   // stores the {{variable}} template text
  version   Int      @default(1)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  agreements   Agreement[]
  paymentLinks PaymentLink[]

  @@map("agreement_templates")
}

model Agreement {
  id               String            @id @default(uuid())
  clientId         String            @map("client_id")
  paymentLinkId    String?           @unique @map("payment_link_id")
  templateId       String            @map("template_id")
  templateVersion  Int               @map("template_version")
  renderedText     String            @map("rendered_text") // frozen snapshot at signing time — never re-rendered later
  planId           String            @map("plan_id")
  price            Decimal           @db.Decimal(10, 2)
  paymentFrequency PaymentFrequency? @map("payment_frequency")
  numberOfPayments Int?              @map("number_of_payments")
  startDate        DateTime          @map("start_date") @db.Date
  termMonths       Int               @map("term_months")
  status           String            @default("pending_signature") // pending_signature | signed
  createdAt        DateTime          @default(now()) @map("created_at")
  deletedAt        DateTime?         @map("deleted_at") // soft delete only

  client      Client             @relation(fields: [clientId], references: [userId])
  paymentLink PaymentLink?       @relation(fields: [paymentLinkId], references: [id])
  template    AgreementTemplate  @relation(fields: [templateId], references: [id])
  plan        Plan               @relation(fields: [planId], references: [id])
  signature   AgreementSignature?

  @@index([clientId])
  @@map("agreements")
}

model AgreementSignature {
  id          String   @id @default(uuid())
  agreementId String   @unique @map("agreement_id")
  signedName  String   @map("signed_name")
  signedAt    DateTime @default(now()) @map("signed_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  status      String   @default("signed")

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@map("agreement_signatures")
}

// ---------------------------------------------------------------------------
// ONBOARDING
// ---------------------------------------------------------------------------

model OnboardingResponse {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  stepKey     String    @map("step_key") // e.g. "goals", "injuries", "equipment"
  answerJson  Json      @map("answer_json")
  completedAt DateTime? @map("completed_at")

  client Client @relation(fields: [clientId], references: [userId])

  @@unique([clientId, stepKey])
  @@map("onboarding_responses")
}

// ---------------------------------------------------------------------------
// TRAINING
// ---------------------------------------------------------------------------

model ExerciseVideo {
  id              String  @id @default(uuid())
  storageProvider String  @map("storage_provider") // "supabase" | "mux"
  externalId      String  @map("external_id") // storage path or Mux asset id
  thumbnailUrl    String? @map("thumbnail_url")
  duration        Int?    // seconds

  exercises Exercise[]

  @@map("exercise_videos")
}

model Exercise {
  id               String   @id @default(uuid())
  name             String
  videoId          String?  @map("video_id")
  musclePrimary    String   @map("muscle_primary")
  muscleSecondary  String[] @map("muscle_secondary")
  equipment        String
  difficulty       String
  movementPattern  String?  @map("movement_pattern")
  instructions     String?
  cues             String?
  commonMistakes   String?  @map("common_mistakes")
  substitutions    String[]
  tags             String[]
  createdAt        DateTime @default(now()) @map("created_at")

  video           ExerciseVideo?    @relation(fields: [videoId], references: [id])
  workoutExercises WorkoutExercise[]

  @@index([musclePrimary])
  @@index([equipment])
  @@map("exercises")
}

model WorkoutTemplate {
  id          String   @id @default(uuid())
  coachId     String   @map("coach_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  coach          User            @relation("TemplateCoach", fields: [coachId], references: [id])
  workouts       Workout[]
  clientPrograms ClientProgram[]

  @@map("workout_templates")
}

model Workout {
  id         String   @id @default(uuid())
  templateId String?  @map("template_id") // null = client-specific, customized copy
  name       String
  dayOrder   Int      @map("day_order")

  template         WorkoutTemplate?  @relation(fields: [templateId], references: [id])
  workoutExercises WorkoutExercise[]
  workoutLogs      WorkoutLog[]

  @@map("workouts")
}

model WorkoutExercise {
  id             String  @id @default(uuid())
  workoutId      String  @map("workout_id")
  exerciseId     String  @map("exercise_id")
  order          Int
  supersetGroup  String? @map("superset_group")
  notes          String?

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  sets    WorkoutSet[]

  @@index([workoutId])
  @@map("workout_exercises")
}

enum SetType {
  warmup
  working
  drop
}

model WorkoutSet {
  id                String  @id @default(uuid())
  workoutExerciseId String  @map("workout_exercise_id")
  setNumber         Int     @map("set_number")
  type              SetType @default(working)
  targetReps        String? @map("target_reps") // stored as text to support ranges like "8-10" or "to failure"
  targetWeight       Decimal? @map("target_weight") @db.Decimal(6, 2)
  targetRir          Int?     @map("target_rir")
  tempo              String?
  restSeconds        Int?     @map("rest_seconds")

  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  logs            WorkoutLogSet[]

  @@map("workout_sets")
}

// Lets one client have a customized copy of a shared template without
// touching anyone else's program.
model ClientProgram {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  templateId  String   @map("workout_template_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  active      Boolean  @default(true)

  client   Client          @relation(fields: [clientId], references: [userId])
  template WorkoutTemplate @relation(fields: [templateId], references: [id])

  @@index([clientId])
  @@map("client_programs")
}

model WorkoutLog {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  workoutId   String    @map("workout_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  duration    Int?      // seconds
  totalVolume Decimal?  @map("total_volume") @db.Decimal(10, 2)

  client  Client          @relation(fields: [clientId], references: [userId])
  workout Workout         @relation(fields: [workoutId], references: [id])
  sets    WorkoutLogSet[]

  @@index([clientId, startedAt])
  @@map("workout_logs")
}

model WorkoutLogSet {
  id             String   @id @default(uuid())
  workoutLogId   String   @map("workout_log_id")
  workoutSetId   String   @map("workout_set_id")
  actualWeight   Decimal? @map("actual_weight") @db.Decimal(6, 2)
  actualReps     Int?     @map("actual_reps")
  isPr           Boolean  @default(false) @map("is_pr")
  notes          String?

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  workoutSet WorkoutSet @relation(fields: [workoutSetId], references: [id])

  @@map("workout_log_sets")
}

// ---------------------------------------------------------------------------
// NUTRITION
// ---------------------------------------------------------------------------

model Food {
  id          String   @id @default(uuid())
  name        String
  source      String   @default("custom") // library | custom | recipe
  calories    Int
  protein     Decimal  @db.Decimal(6, 2)
  carbs       Decimal  @db.Decimal(6, 2)
  fat         Decimal  @db.Decimal(6, 2)
  servingSize String?  @map("serving_size")
  // Protein | Carbs | Fats | Veg | Fruit | Dairy | Meals | Snacks | Drinks |
  // Alcohol | Condiments. Only used for browsing when there's no search term —
  // a client who doesn't know what to type still needs a way in.
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  nutritionLogs NutritionLog[]
  mealPlanItems MealPlanItem[]

  @@map("foods")
}

model Recipe {
  id              String   @id @default(uuid())
  coachId         String?  @map("coach_id")
  title           String
  imageUrl        String?  @map("image_url")
  calories        Int
  protein         Decimal  @db.Decimal(6, 2)
  carbs           Decimal  @db.Decimal(6, 2)
  fat             Decimal  @db.Decimal(6, 2)
  servingSize     String?  @map("serving_size")
  ingredientsJson Json     @map("ingredients_json")
  instructions    String
  prepTime        Int?     @map("prep_time")
  cookTime        Int?     @map("cook_time")
  tags            String[]
  createdAt       DateTime @default(now()) @map("created_at")

  coach         User?          @relation("RecipeCoach", fields: [coachId], references: [id])
  nutritionLogs NutritionLog[]
  mealPlanItems MealPlanItem[]

  @@index([calories])
  @@map("recipes")
}

model NutritionLog {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  date      DateTime @db.Date
  meal      String?  // breakfast | lunch | dinner | snack | null
  foodId    String?  @map("food_id")
  recipeId  String?  @map("recipe_id")
  quantity  Decimal  @default(1) @db.Decimal(6, 2)
  // Set only for quick-added entries the client chose not to save as a food.
  // Without it a one-off restaurant meal logs as an anonymous row.
  name      String?
  // Private bucket path, never a public URL — see lib/meal-photos.ts.
  photoPath String?  @map("photo_path")
  calories  Int
  protein   Decimal  @db.Decimal(6, 2)
  carbs     Decimal  @db.Decimal(6, 2)
  fat       Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at")

  // Where the numbers on this row came from:
  //   manual  — the client typed them in
  //   library — copied from a Food row
  //   recipe  — copied from a Recipe row
  //   photo   — read off a photograph
  source String @default("manual")

  // Set only when source is photo.
  //   estimated — nobody has looked at it yet
  //   confirmed — the coach agreed with the numbers
  //   corrected — the coach changed them
  //   failed    — the read didn't come back, so the row holds zeros and the
  //               client still needs to enter numbers
  // Null on every other source, which is what keeps the review queue from
  // filling up with rows nobody ever needs to look at.
  reviewState String? @map("review_state")

  // What was actually read off the photo: the items, the portion assumed for
  // each, and the model's own numbers. Kept separately from the columns above
  // so that a coach's correction can be compared against the original guess
  // rather than erasing it — the gap between the two is the only way to find
  // out whether the reads run consistently high or low.
  estimate Json?

  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")

  client     Client  @relation(fields: [clientId], references: [userId])
  food       Food?   @relation(fields: [foodId], references: [id])
  recipe     Recipe? @relation(fields: [recipeId], references: [id])
  reviewedBy User?   @relation("MealReviewer", fields: [reviewedById], references: [id])

  @@index([clientId, date])
  // Drives the coach's review queue, which reads oldest-unreviewed-first.
  @@index([reviewState, createdAt])
  @@map("nutrition_logs")
}

model NutritionTarget {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  calories      Int
  protein       Decimal  @db.Decimal(6, 2)
  carbs         Decimal  @db.Decimal(6, 2)
  fat           Decimal  @db.Decimal(6, 2)
  effectiveDate DateTime @map("effective_date") @db.Date

  client Client @relation(fields: [clientId], references: [userId])

  @@index([clientId, effectiveDate])
  @@map("nutrition_targets")
}

// ---------------------------------------------------------------------------
// ACCOUNTABILITY
// ---------------------------------------------------------------------------

model DailyGoal {
  id         String   @id @default(uuid())
  clientId   String   @map("client_id")
  goalType   String   @map("goal_type") // workout | steps | protein | calories | water | sleep | photo | custom
  targetValue String? @map("target_value")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  client Client         @relation(fields: [clientId], references: [userId])
  logs   DailyGoalLog[]

  @@index([clientId])
  @@map("daily_goals")
}

model DailyGoalLog {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  dailyGoalId   String   @map("daily_goal_id")
  date          DateTime @db.Date
  completed     Boolean  @default(false)
  autoCompleted Boolean  @default(false) @map("auto_completed")

  client    Client    @relation(fields: [clientId], references: [userId])
  dailyGoal DailyGoal @relation(fields: [dailyGoalId], references: [id])

  @@unique([dailyGoalId, date])
  @@index([clientId, date])
  @@map("daily_goal_logs")
}

model StepLog {
  id       String   @id @default(uuid())
  clientId String   @map("client_id")
  date     DateTime @db.Date
  steps    Int
  source   String   @default("manual") // manual | apple_health | google_health

  client Client @relation(fields: [clientId], references: [userId])

  @@unique([clientId, date])
  @@index([clientId, date])
  @@map("step_logs")
}

model WeightLog {
  id       String   @id @default(uuid())
  clientId String   @map("client_id")
  date     DateTime @db.Date
  weight   Decimal  @db.Decimal(6, 2)

  client Client @relation(fields: [clientId], references: [userId])

  @@index([clientId, date])
  @@map("weight_logs")
}

model Measurement {
  id       String   @id @default(uuid())
  clientId String   @map("client_id")
  date     DateTime @db.Date
  type     String   // waist | chest | arms | thighs | etc.
  value    Decimal  @db.Decimal(6, 2)

  client Client @relation(fields: [clientId], references: [userId])

  @@index([clientId, date])
  @@map("measurements")
}

model ProgressPhoto {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  date        DateTime @db.Date
  angle       String   // front | side | back
  storagePath String   @map("storage_path") // private bucket path, never a public URL

  client Client @relation(fields: [clientId], references: [userId])

  @@index([clientId, date])
  @@map("progress_photos")
}

model CheckIn {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  weekOf      DateTime  @map("week_of") @db.Date
  answersJson Json      @map("answers_json")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  aiSummary   String?   @map("ai_summary") // always shown alongside raw answers, never instead of

  client Client @relation(fields: [clientId], references: [userId])

  @@index([clientId, weekOf])
  @@map("check_ins")
}

// ---------------------------------------------------------------------------
// MESSAGING
// ---------------------------------------------------------------------------

model Message {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  body        String?
  contextType String?   @map("context_type") // meal | workout | exercise | progress | null
  contextId   String?   @map("context_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")

  sender      User                @relation("MessageSender", fields: [senderId], references: [id])
  recipient   User                @relation("MessageRecipient", fields: [recipientId], references: [id])
  attachments MessageAttachment[]

  @@index([senderId, recipientId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id          String @id @default(uuid())
  messageId   String @map("message_id")
  storagePath String @map("storage_path")
  type        String // photo | video | voice

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

model AiConversation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  roleContext String   @map("role_context") // client | coach
  startedAt   DateTime @default(now()) @map("started_at")

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // user | assistant | tool
  content        String
  toolCallsJson  Json?    @map("tool_calls_json")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// SYSTEM
// ---------------------------------------------------------------------------

// One row per browser that agreed to receive pushes — a client on a phone and
// a laptop is two rows, and both should ring.
//
// endpoint is unique because it IS the browser's identity to the push service.
// Re-subscribing on the same device returns the same endpoint, so upserting on
// it is what stops duplicates piling up every time the app is opened.
//
// Subscriptions expire on their own — the browser is reinstalled, permission
// is revoked, the push service retires it. The send path deletes any row the
// service reports as gone, so this table prunes itself rather than slowly
// filling with endpoints that can never be delivered to.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// A day of meals a coach has written for one client.
//
// This is the thing coaches do over text constantly — "go with the pollo
// asado", "chicken burrito bowl with double rice at lunch" — and the app had
// nowhere to put it. Without a plan the nutrition screen opens on a search
// box, which only helps somebody who already knows what they should be
// eating.
//
// One active plan per client at a time. A history of superseded plans is
// worth keeping (it shows what was asked of somebody in the weeks a change
// actually happened), so replacing a plan deactivates the old one instead of
// deleting it.
model MealPlan {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  coachId   String?  @map("coach_id")
  name      String
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  client Client         @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  coach  User?          @relation("MealPlanCoach", fields: [coachId], references: [id])
  items  MealPlanItem[]

  @@index([clientId, active])
  @@map("meal_plans")
}

// One line of a plan.
//
// The macros are copied onto the row rather than read through recipeId at
// display time. A recipe edited in November must not silently rewrite what a
// client was told to eat in September, and a plan line has to keep working
// when the recipe behind it is deleted.
model MealPlanItem {
  id       String  @id @default(uuid())
  planId   String  @map("plan_id")
  meal     String // breakfast | lunch | dinner | snack
  position Int     @default(0)

  // Set when the line came from the library, so the client can open the full
  // recipe. Null for a line the coach typed straight in.
  recipeId String? @map("recipe_id")
  foodId   String? @map("food_id")

  name     String
  quantity Decimal @default(1) @db.Decimal(6, 2)
  calories Int
  protein  Decimal @db.Decimal(6, 2)
  carbs    Decimal @db.Decimal(6, 2)
  fat      Decimal @db.Decimal(6, 2)
  note     String?

  plan   MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe Recipe?  @relation(fields: [recipeId], references: [id])
  food   Food?    @relation(fields: [foodId], references: [id])

  @@index([planId])
  @@map("meal_plan_items")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@map("audit_logs")
}
